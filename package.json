{
  "name": "game-idea-lab",
  "productName": "Game Idea Lab",
  "version": "0.1.0",
  "description": "ランダムなキーワードとゲームジャンルの組み合わせから、ゲームアイデアの種を見つけるデスクトップアプリ",
  "license": "MIT",
  "author": "yodeff",
  "homepage": "https://github.com/yodeff/GameIdeaLab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yodeff/GameIdeaLab.git"
  },
  "bugs": {
    "url": "https://github.com/yodeff/GameIdeaLab/issues"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:browser": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.renderer.config.ts && node -e \"for (const f of ['LICENSE', 'THIRD_PARTY_NOTICES.md']) require('node:fs').copyFileSync(f, 'out/web/' + f)\"",
    "dist:win": "npm run build && node tools/gen-notices.mjs && node tools/dist-win.mjs",
    "dist:mac": "npm run build && node tools/gen-notices.mjs && electron-builder --mac dmg --arm64 --x64",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run check:public",
    "check:public": "node tools/check-public.mjs",
    "smoke:restart": "node tools/restart-cycles.mjs",
    "eval:ideas": "electron-vite build && electron . --eval-ideas",
    "bench:models": "electron-vite build && electron . --bench-models"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
