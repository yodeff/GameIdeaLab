{
  "name": "game-idea-lab",
  "productName": "Game Idea Lab",
  "version": "0.0.1",
  "description": "ランダムなキーワードとゲームジャンルの組み合わせから、ゲームアイデアの種を見つけるデスクトップアプリ",
  "license": "MIT",
  "author": "yodeff",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:browser": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run check:public",
    "check:public": "node tools/check-public.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
